# Rename this file to .env and fill in your values

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model used for chat / summarize / translate / knowledge graph / compare
GROQ_MODEL=llama-3.3-70b-versatile

# Secret used to sign JWT auth tokens - change this to any random string
JWT_SECRET=change-this-to-a-long-random-string

# SQLite by default (zero setup). To use Postgres/Cloud SQL instead, set e.g.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/athenaiq
DATABASE_URL=sqlite:///./athenaiq.db

# Where uploaded files are stored on disk
UPLOAD_DIR=./uploads

# SMTP Configuration for sending emails (e.g. user invites)
# If using Gmail, use smtp.gmail.com, port 465 (SSL) or 587 (TLS), and an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
